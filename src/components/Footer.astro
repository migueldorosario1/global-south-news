---
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} Global South News. All rights reserved.</p>
	<p class="footer-note">A newsroom architecture for development, sovereignty and multipolar politics.</p>
</footer>

<style>
	footer {
		padding: 2.5rem 1rem 4rem;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}

	footer p {
		margin: 0.35rem 0;
	}

	.footer-note {
		font-size: 0.95rem;
	}
</style>
