---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import logoImg from '../assets/logo.png';

const navItems = [
	{ href: '/', label: 'Home' },
	{ href: '/tags/multipolar-world', label: 'Multipolar World' },
	{ href: '/tags/brics', label: 'BRICS' },
	{ href: '/tags/development', label: 'Development' },
	{ href: '/tags/latin-america', label: 'Latin America' },
	{ href: '/tags/trade', label: 'Trade' },
	{ href: '/editorial', label: 'Editorial' },
	{ href: '/quem-somos', label: 'About' },
];
---

<header class="site-header">
	<nav class="navbar" aria-label="Main navigation">
		<a href="/" class="logo-link" aria-label={SITE_TITLE}>
			<img src={logoImg.src} alt={SITE_TITLE} width="525" height="225" class="logo-img" />
		</a>
		<div class="header-copy">
			<p class="kicker">Development, sovereignty and multipolar politics</p>
			<div class="nav-links">
				{navItems.map((item) => <HeaderLink href={item.href}>{item.label}</HeaderLink>)}
			</div>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 1000;
		background: rgba(255, 255, 255, 0.96);
		backdrop-filter: blur(14px);
		border-bottom: 1px solid rgba(17, 24, 39, 0.08);
	}

	.navbar {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 1.5rem;
		align-items: center;
		max-width: 1180px;
		margin: 0 auto;
		padding: 0.8rem 1.25rem;
	}

	.logo-link {
		display: flex;
		align-items: center;
		width: 220px;
	}

	.logo-img {
		width: 100%;
		height: auto;
		object-fit: contain;
	}

	.header-copy {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		min-width: 0;
	}

	.kicker {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.9rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.nav-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.85rem;
		align-items: center;
	}

	@media (max-width: 720px) {
		.navbar {
			grid-template-columns: 1fr;
			gap: 0.75rem;
			padding: 0.75rem 1rem;
		}

		.logo-link {
			width: 190px;
		}

		.kicker {
			font-size: 0.78rem;
			line-height: 1.35;
		}
	}
</style>
